<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>forge</artifactId>
        <groupId>forge</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-protocol2-bridge</artifactId>
    <name>Forge Protocol-2 Bridge</name>
    <description>
        WS-A1D-H4F: GPL-side, separate-process Commander Lab Protocol-2.0.0 bridge.
        Adapter/controller boundary over the real pinned Forge rules engine.
        Not a second rules engine: all legality, costs and execution stay in Forge.
    </description>

    <properties>
        <!-- Build-time default for the engine pin identity. The runtime value
             comes from the FORGE_ENGINE_SHA environment variable; this property
             only records what was visible at build time and must never be
             hand-edited into a conflicting pin.
             WSR24 (PB-05): additionally, native git materializes
             the exact build source (commit + tree + dirty flag) into bridge.properties
             as engine.git_commit/engine.git_tree/engine.git_dirty. That build-derived identity
             cannot be altered at runtime by changing environment variables; the
             version payload always carries it alongside the operator claim so
             divergence is visible, never silent. Tarball builds without .git
             record unavailable values (honest, never faked). -->
        <forge.engine.sha>${env.FORGE_ENGINE_SHA}</forge.engine.sha>
    </properties>

    <dependencies>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-game</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.13.2</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- WSR24 (PB-05): materialize the exact build source into filtered
                 resources using native git (worktree-correct, unlike JGit
                 based readers which misattribute linked-worktree HEAD).
                 Missing git fails soft here (properties stay unfiltered
                 placeholders, read as unavailable); the usability gate still
                 fails closed on missing identity. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <!-- Export so resource filtering sees git.commit.id.full,
                         git.tree.full and git.dirty below. -->
                    <exportAntProperties>true</exportAntProperties>
                </configuration>
                <executions>
                    <execution>
                        <id>record-build-source</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>initialize</phase>
                        <configuration>
                            <target>
                                <exec executable="git" dir="${project.basedir}"
                                        failifexecutionfails="false"
                                        resultproperty="git.head.exit"
                                        outputproperty="git.head.raw">
                                    <arg value="rev-parse"/>
                                    <arg value="HEAD"/>
                                </exec>
                                <exec executable="git" dir="${project.basedir}"
                                        failifexecutionfails="false"
                                        resultproperty="git.tree.exit"
                                        outputproperty="git.tree.raw">
                                    <arg value="rev-parse"/>
                                    <arg value="HEAD^{tree}"/>
                                </exec>
                                <exec executable="git" dir="${project.basedir}"
                                        failifexecutionfails="false"
                                        resultproperty="git.status.exit"
                                        outputproperty="git.status.raw">
                                    <arg value="status"/>
                                    <arg value="--porcelain"/>
                                </exec>
                                <condition property="git.commit.id.full"
                                        value="${git.head.raw}">
                                    <and>
                                        <equals arg1="${git.head.exit}" arg2="0"/>
                                        <matches pattern="^[0-9a-f]{40}\s*$"
                                                string="${git.head.raw}"/>
                                    </and>
                                </condition>
                                <condition property="git.tree.full"
                                        value="${git.tree.raw}">
                                    <and>
                                        <equals arg1="${git.tree.exit}" arg2="0"/>
                                        <matches pattern="^[0-9a-f]{40}\s*$"
                                                string="${git.tree.raw}"/>
                                    </and>
                                </condition>
                                <condition property="git.dirty" value="true">
                                    <and>
                                        <equals arg1="${git.status.exit}" arg2="0"/>
                                        <isset property="git.commit.id.full"/>
                                        <isset property="git.tree.full"/>
                                        <isset property="git.status.raw"/>
                                        <not>
                                            <equals arg1="${git.status.raw}" arg2=""/>
                                        </not>
                                    </and>
                                </condition>
                                <condition property="git.dirty" value="false">
                                    <and>
                                        <equals arg1="${git.status.exit}" arg2="0"/>
                                        <isset property="git.commit.id.full"/>
                                        <isset property="git.tree.full"/>
                                        <isset property="git.status.raw"/>
                                        <equals arg1="${git.status.raw}" arg2=""/>
                                    </and>
                                </condition>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>forge.bridge.BridgeMain</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
