<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>forge</artifactId>
        <groupId>forge</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-protocol2-bridge</artifactId>
    <name>Forge Protocol-2 Bridge</name>
    <description>
        WS-A1D-H4F: GPL-side, separate-process Commander Lab Protocol-2.0.0 bridge.
        Adapter/controller boundary over the real pinned Forge rules engine.
        Not a second rules engine: all legality, costs and execution stay in Forge.
    </description>

    <properties>
        <!-- Build-time default for the engine pin identity. The runtime value
             comes from the FORGE_ENGINE_SHA environment variable; this property
             only records what was visible at build time and must never be
             hand-edited into a conflicting pin.
             WSR24 (PB-05): additionally, the git-commit-id plugin materializes
             the exact build source (commit + dirty flag) into bridge.properties
             as engine.git_commit/engine.git_dirty. That build-derived identity
             cannot be altered at runtime by changing environment variables; the
             version payload always carries it alongside the operator claim so
             divergence is visible, never silent. Tarball builds without .git
             record unavailable values (honest, never faked). -->
        <forge.engine.sha>${env.FORGE_ENGINE_SHA}</forge.engine.sha>
    </properties>

    <dependencies>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-game</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.13.2</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- WSR24 (PB-05): materialize the exact build source into filtered
                 resources. Never hand-edited; absent .git yields unavailable
                 values (fail-soft here, fail-closed at the usability gate). -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>9.0.1</version>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <failOnNoGitDir>false</failOnNoGitDir>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                    <generateGitPropertiesFile>false</generateGitPropertiesFile>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git.commit.id.full$</includeOnlyProperty>
                        <includeOnlyProperty>^git.dirty$</includeOnlyProperty>
                    </includeOnlyProperties>
                    <commitIdGenerationMode>full</commitIdGenerationMode>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>forge.bridge.BridgeMain</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
